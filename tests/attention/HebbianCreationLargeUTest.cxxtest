#include <cxxtest/TestSuite.h>

#include <opencog/attention/AttentionModule.h>
#include <opencog/attention/AttentionParamQuery.h>
#include <opencog/attention/HebbianCreationAgent.h>

#include <opencog/attention/Neighbors.h>
#include <opencog/cogserver/server/CogServer.h>
#include <opencog/cogserver/modules/agents/AgentsModule.h>
#include <opencog/cogserver/modules/agents/Scheduler.h>
#include <opencog/attentionbank/bank/AttentionBank.h>
#include <opencog/attentionbank/types/atom_types.h>
#include <opencog/attentionbank/avalue/AttentionValue.h>
#include <opencog/atoms/truthvalue/SimpleTruthValue.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/util/Logger.h>
#include <opencog/util/Config.h>
#include <opencog/util/algorithm.h>
#include <opencog/cogserver/server/Factory.h>

#include <vector>
#include <string>
#include <fstream>
#include <chrono>

using namespace opencog;
using namespace std;

class HebbianCreationModuleUTest : public CxxTest::TestSuite
{
private:
    AtomSpace* as;
    AgentPtr _hebbiancreation_agentptr;
    CogServer* _cogserver;
    Scheduler* _scheduler;

public:
    void tearDown()
    {
        _cogserver->stop();
    }

    void setUp()
    {
        _cogserver = &cogserver();
        config().set("MODULES", "opencog/attention/libattention.so");
        _cogserver->loadModules();
        config().set("MODULES", "libagents.so");


        Module* amod = _cogserver->getModule("opencog::AgentsModule");
        AgentsModule* agmod = (AgentsModule*) amod;
        _scheduler = &agmod->get_scheduler();

        AttentionParamQuery _atq(&cogserver().getAtomSpace());
        _atq.load_default_values(); // Load default ECAN param values into AS

        Factory<HebbianCreationAgent, Agent> hebbianCreationFactory;
        _scheduler->registerAgent(HebbianCreationAgent::info().id,&hebbianCreationFactory);
        _hebbiancreation_agentptr =
        _scheduler->createAgent(HebbianCreationAgent::info().id,false);

        as = &cogserver().getAtomSpace();
        std:: cout << "HebbianCreationAgent registered" << std::endl;
    }

    void testHebbianLinkCreation(void)
    {
        // InitCogServer();
        // We will run the agent manually to benchmark it.
        // _scheduler->startAgent(_hebbiancreation_agentptr,true,"hca");

        AttentionBank& ab = attentionbank(&cogserver().getAtomSpace());
        ab.set_af_size(100);
        std::cout << "AF size set to: " << ab.get_af_size() << std::endl;

        std::vector<Handle> nodesList;
        int nodeCount = 50; // Number of nodes to create for testing

        for (int i = 0; i < nodeCount; ++i) {
            std::string name = "Node_" + std::to_string(i);
            Handle node = as->add_node(CONCEPT_NODE,"Node_" + std::to_string(i));
            nodesList.push_back(node);
            ab.stimulate(node, 50);
        }



        // Wait a small amount for the signals to be processed by AttentionModule
        // since stimulation triggers signals that push to the queue.
        std::this_thread::sleep_for(std::chrono::milliseconds(200));

        size_t afCount = AttentionModule::newAtomsInAV.size();
        std::cout << "Items in newAtomsInAV to process: " << afCount << std::endl;

        // Manual run for benchmarking
        auto start = std::chrono::high_resolution_clock::now();
        while (!AttentionModule::newAtomsInAV.is_empty()) {
            _hebbiancreation_agentptr->run();
        }
        auto end = std::chrono::high_resolution_clock::now();

        std::chrono::duration<double> diff = end - start;
        std::cout << "HebbianCreationAgent profiling: " << std::endl;
        std::cout << "Total time  "  << diff.count() << " seconds." << std::endl;
        if (afCount > 0)
            std::cout << "Average time per atom run: " << (diff.count() / afCount) << " seconds." << std::endl;

        HandleSeq hebbianLinks;
        as->get_handles_by_type(back_inserter(hebbianLinks), ASYMMETRIC_HEBBIAN_LINK);
        std::cout << "count(HebLinks) = " << hebbianLinks.size() << "\n";
        
        // Assert that links were created. 
        size_t n = nodesList.size();
        size_t expectedCount = n * (n - 1);
        TS_ASSERT(hebbianLinks.size() == expectedCount);
    }
};
