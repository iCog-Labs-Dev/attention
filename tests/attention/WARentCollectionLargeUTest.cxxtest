
#include <cxxtest/TestSuite.h>
#include <opencog/attention/WARentCollectionAgent.h>
#include <opencog/cogserver/modules/agents/Scheduler.h>
#include <opencog/cogserver/server/CogServer.h>
#include <opencog/attentionbank/bank/AttentionBank.h>
#include <opencog/attentionbank/avalue/AttentionValue.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/util/Config.h>
#include <opencog/cogserver/modules/agents/AgentsModule.h>
#include <opencog/attention/AttentionParamQuery.h>
#include <opencog/attentionbank/bank/AVUtils.h>
#include <chrono>
#include <vector>
#include <iostream>

using namespace opencog;

class WARentCollectionLargeUTest : public CxxTest::TestSuite
{
private:
    AtomSpace* as;
    WARentCollectionAgent* _wagent;
    CogServer* _cogserver;
    Scheduler* _scheduler;

public:
    void setUp()
    {
        _cogserver = &cogserver();
        config().set("MODULES", "opencog/attention/libattention.so");
        _cogserver->loadModules();
        config().set("MODULES", "libagents.so");

        Module* amod = _cogserver->getModule("opencog::AgentsModule");
        AgentsModule* agmod = static_cast<AgentsModule*>(amod);
        _scheduler = &agmod->get_scheduler();

        as = &_cogserver->getAtomSpace();

        _wagent = new WARentCollectionAgent(*_cogserver);

        AbstractFactory<Agent>* warentFactory = new Factory<WARentCollectionAgent, Agent>;
        _scheduler->registerAgent(WARentCollectionAgent::info().id, warentFactory);

        AttentionParamQuery atq(as);
        atq.load_default_values();

        std::cout << "Setup completed for WARentCollectionLargeUTest." << std::endl;
    }

    void tearDown()
    {
        delete _wagent;
        _cogserver->stop();
        std::cout << "TearDown completed for WARentCollectionLargeUTest." << std::endl;
    }

    void testWARentScaling()
    {
        AttentionBank& ab = attentionbank(as);
        
        // 1. Restrict AF size
        ab.set_af_size(100);
        std::cout << "AF size restricted to: " << ab.get_af_size() << std::endl;

        // 2. Populate with large number of atoms
        int atomCount = 101;
        std::cout << "Creating " << atomCount << " atoms..." << std::endl;
        std::vector<Handle> atoms;
        for (int i = 0; i < atomCount; ++i) {
            Handle h = as->add_node(CONCEPT_NODE, "WANode_" + std::to_string(i));
            // Keep STI low so they stay outside AF
            ab.stimulate(h, 45);
            atoms.push_back(h);
        }

        // Wait a bit to ensure elapsed_time > 0 for rent calculation
        std::this_thread::sleep_for(std::chrono::milliseconds(200));

        // 3. Benchmark WARentCollectionAgent::run()
        int runCount = 5;
        std::cout << "Benchmarking WARentCollectionAgent::run() for " << runCount << " cycles..." << std::endl;
        float x = get_sti(atoms[100]);
        std::chrono::nanoseconds total_work_time(0);
        for (int i = 0; i < runCount; ++i) {
            // Stimulate a subset of atoms to ensure they have recent activity
            for (size_t j = 0; j < atoms.size(); ++j) {
                ab.stimulate(atoms[j], 10);
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(500)); 
            
            auto start_run = std::chrono::high_resolution_clock::now();
            _wagent->run();
            auto end_run = std::chrono::high_resolution_clock::now();
            
            total_work_time += std::chrono::duration_cast<std::chrono::nanoseconds>(end_run - start_run);
        }
         double total_seconds = std::chrono::duration<double>(total_work_time).count();

        std::cout << "Benchmark Finished." << std::endl;
                std::cout <<"sti of last atom before run "<<x<<std::endl;
        std::cout <<"sti of last atom "<<get_sti(atoms[100])<<std::endl;
        std::cout << "Total time for " << runCount << " runs with " << atomCount << " atoms: " << total_seconds << " seconds." << std::endl;
        std::cout << "Average time per run: " << (total_seconds / runCount) << " seconds." << std::endl;

 
    }

};
