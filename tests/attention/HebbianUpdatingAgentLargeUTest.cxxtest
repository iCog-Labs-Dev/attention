/*
 * tests/dynamics/HebbianUpdatingAgentLargeUTest.cxxtest
 *
 * Unit test for HebbianUpdatingAgent with larger scale data.
 */

#include <cxxtest/TestSuite.h>
#include <iostream>
#include <vector>
#include <string>
#include <fstream>
#include <map>

#include <opencog/attentionbank/bank/AttentionBank.h>
#include <opencog/attention/HebbianUpdatingAgent.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/atoms/truthvalue/SimpleTruthValue.h>
#include <opencog/cogserver/server/CogServer.h>
#include <opencog/util/Logger.h>
#include <opencog/util/Config.h>
#include <opencog/cogserver/modules/agents/AgentsModule.h>
#include <opencog/attentionbank/types/atom_types.h>
#include <opencog/attention/AttentionParamQuery.h>
#include <chrono>
using namespace opencog;

class HebbianUpdatingAgentLargeUTest : public CxxTest::TestSuite
{
private:
    AtomSpace* as;
    CogServer* cogServer;
    Scheduler* scheduler;
    HebbianUpdatingAgent* hebbianUpdatingAgent;

public:
    void setUp()
    {
        cogServer = &cogserver();
        config().set("MODULES", "opencog/attention/libattention.so");
        cogServer->loadModules();
        config().set("MODULES", "libagents.so");

        Module* amod = cogServer->getModule("opencog::AgentsModule");
        AgentsModule* agmod = static_cast<AgentsModule*>(amod);
        scheduler = &agmod->get_scheduler();

        as = &cogserver().getAtomSpace();
        hebbianUpdatingAgent = new HebbianUpdatingAgent(*cogServer);

        // Load default values to ensure AttentionBank is configured
        AttentionParamQuery atq(as);
        atq.load_default_values();

        // Add the HebbianUpdatingAgent to the scheduler
        AbstractFactory<Agent>* hebbianUpdatingFactory = new Factory<HebbianUpdatingAgent, Agent>();
        scheduler->registerAgent(HebbianUpdatingAgent::info().id, hebbianUpdatingFactory);

        std::cout << "Setup completed for HebbianUpdatingAgentLargeUTest." << std::endl;
     }

    void tearDown()
    {
        delete hebbianUpdatingAgent;
        cogServer->stop();
        std::cout << "TearDown completed for HebbianUpdatingAgentLargeUTest." << std::endl;
    }

    void testLargeHebbianLinkUpdate()
    {
        // 1. Load meaningful names from file
        std::vector<std::string> names;
        
            for (int i = 0; i < 100; ++i) {
                names.push_back("LeafNode_" + std::to_string(i));
            }

        // 2. Create one central HubNode and 100 Leaf nodes
        AttentionBank& ab = attentionbank(as);
        ab.set_af_size(1); // Ensure AF size is enough
        
        Handle hubNode = as->add_node(CONCEPT_NODE, "HubNode");
        // hubNode->setTruthValue(SimpleTruthValue::createTV(1.0, 1.0));
        ab.stimulate(hubNode, 1000); // High STI for the hub

        std::vector<Handle> leafNodes;
        std::vector<Handle> hebbianLinks;

        for (const auto& name : names) {
            Handle leaf = as->add_node(CONCEPT_NODE, std::string(name));
            leafNodes.push_back(leaf);

            // 3. Create Hebbian Link: HubNode -> Leaf
            Handle link = as->add_link(ASYMMETRIC_HEBBIAN_LINK, hubNode, leaf);
            // Use lower confidence (0.1) so it can be updated
            link->setTruthValue(SimpleTruthValue::createTV(0.01, 0.1));
            hebbianLinks.push_back(link);
        }

        std::cout << "Created HubNode with " << hebbianLinks.size() << " Hebbian links." << std::endl;
        

        // 4. Capture initial state
        std::map<Handle, double> initialMeans;
        for (const auto& link : hebbianLinks) {
            initialMeans[link] = link->getTruthValue()->get_mean();
            // std::cout<<"mean before "<<initialMeans[link]<<std::endl;
        }


        int runCount = 1; 
        auto start = std::chrono::high_resolution_clock::now();
        for (int i = 0; i < runCount; ++i) {
            hebbianUpdatingAgent->run();
        }
        auto end = std::chrono::high_resolution_clock::now();
        std::chrono::duration<double> diff = end - start;
        std::cout << "Executed " << runCount << " cycles in " << diff.count() << " seconds." << std::endl;

        // 6. Verification: Check how many links were updated
        int updatedCount = 0;
        for (const auto& link : hebbianLinks) {
            double currentMean = link->getTruthValue()->get_mean();
            if (std::abs(currentMean - initialMeans[link]) > 1e-6) {
                updatedCount++;
            }
        }

        std::cout << "Updated " << updatedCount << " out of " << hebbianLinks.size() << " links." << std::endl;
        if (updatedCount > 0) {
            std::cout << "Successfully updated Hub links. Updated count should be " << hebbianLinks.size() << " if HubNode was picked at least once." << std::endl;
        }

        // Verify all remain valid probability values
        for (const auto& link : hebbianLinks) {
            double m = link->getTruthValue()->get_mean();
            TS_ASSERT(m >= 0.0 && m <= 1.0);
        }
    }
};
