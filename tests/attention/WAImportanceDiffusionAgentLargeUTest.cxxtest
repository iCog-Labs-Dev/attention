/*
 * tests/attention/WAImportanceDiffusionAgentLargeUTest.cxxtest
 *
 * Benchmark for WAImportanceDiffusionAgent with a star topology.
 */

#include <cxxtest/TestSuite.h>
#include <opencog/attentionbank/bank/AttentionBank.h>
#include <opencog/attention/WAImportanceDiffusionAgent.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/cogserver/server/CogServer.h>
#include <opencog/util/Logger.h>
#include <opencog/util/Config.h>
#include <opencog/cogserver/modules/agents/AgentsModule.h>
#include <opencog/attentionbank/types/atom_types.h>
#include <opencog/attention/AttentionParamQuery.h>
#include <opencog/atoms/truthvalue/SimpleTruthValue.h>
#include <iostream>
#include <vector>
#include <chrono>

using namespace opencog;

class WAImportanceDiffusionAgentLargeUTest : public CxxTest::TestSuite
{
private:
	AtomSpace* as;
	CogServer* cogServer;
	Scheduler* scheduler;
	WAImportanceDiffusionAgent* waImportanceDiffusionAgent;
	AttentionParamQuery* atq;

public:
	void setUp()
	{
		cogServer = &cogserver();
		config().set("MODULES", "opencog/attention/libattention.so");
		cogServer->loadModules();
		config().set("MODULES", "libagents.so");

		Module* amod = cogServer->getModule("opencog::AgentsModule");
		AgentsModule* agmod = static_cast<AgentsModule*>(amod);
		scheduler = &agmod->get_scheduler();

		as = &cogserver().getAtomSpace();
		waImportanceDiffusionAgent = new WAImportanceDiffusionAgent(*cogServer);

		atq = new AttentionParamQuery(as);
		atq->load_default_values();

		AbstractFactory<Agent>* waImportanceDiffusionAgentFactory =
			new Factory<WAImportanceDiffusionAgent, Agent>();
		scheduler->registerAgent(WAImportanceDiffusionAgent::info().id,
								 waImportanceDiffusionAgentFactory);

		std::cout << "Setup completed for WAImportanceDiffusionAgentLargeUTest." << std::endl;
	}

	void tearDown()
	{
		delete waImportanceDiffusionAgent;
		delete atq;
		cogServer->stop();
		std::cout << "TearDown completed for WAImportanceDiffusionAgentLargeUTest." << std::endl;
	}

	void testLargeDiffusionBenchmark()
	{
		AttentionBank& ab = attentionbank(as);
		ab.set_af_size(1);
		std::cout << "AF size set to: " << ab.get_af_size() << std::endl;

		// One atom stays in AF, star node stays outside AF but is stimulated.
		Handle afAnchor = as->add_node(CONCEPT_NODE, "AF_Anchor");
		Handle star = as->add_node(CONCEPT_NODE, "StarNode");

		ab.stimulate(afAnchor, 3000);
		ab.stimulate(star, 2000);

		int leafCount = 100;
		std::vector<Handle> leaves;
		std::vector<Handle> links;
		leaves.reserve(leafCount);

		for (int i = 0; i < leafCount; ++i) {
			Handle leaf = as->add_node(CONCEPT_NODE, "Leaf_" + std::to_string(i));
			leaves.push_back(leaf);
			Handle link = as->add_link(INHERITANCE_LINK, star, leaf);
			link->setTruthValue(SimpleTruthValue::createTV(0.5, 0.8));
			links.push_back(link);
		}

		std::cout << "Benchmark Setup: 1 AF anchor, 1 star node, "
				  << leafCount << " leaves." << std::endl;

		std::cout << "\nInitial STI check:" << std::endl;
		std::cout << "AF_Anchor STI:        " << get_sti(afAnchor) << std::endl;
		std::cout << "StarNode STI:         " << get_sti(star) << std::endl;
		std::cout << "InheritanceLink_0 STI:" << get_sti(links[0]) << std::endl;
		std::cout << "Leaf_0 STI:           " << get_sti(leaves[0]) << std::endl;

		int cycles = 10; 
		std::cout << "\nStarting benchmark of " << cycles << " diffusion cycles..." << std::endl;

		std::chrono::nanoseconds total_work_time(0);
		for (int i = 0; i < cycles; ++i) {
			auto start_run = std::chrono::high_resolution_clock::now();
			waImportanceDiffusionAgent->run();
			auto end_run = std::chrono::high_resolution_clock::now();
			total_work_time += std::chrono::duration_cast<std::chrono::nanoseconds>(end_run - start_run);
		}

		double total_seconds = std::chrono::duration<double>(total_work_time).count();
		std::cout << "\n--- DIFFUSION BENCHMARK RESULTS ---" << std::endl;
		std::cout << "Total time:          " << total_seconds << " s" << std::endl;
		std::cout << "Avg time per cycle:  " << (total_seconds / cycles) * 1000.0 << " ms" << std::endl;
		std::cout << "-----------------------------------\n" << std::endl;

		std::cout << "Final STI check:" << std::endl;
		std::cout << "AF_Anchor STI:        " << get_sti(afAnchor) << std::endl;
		std::cout << "StarNode STI:         " << get_sti(star) << std::endl;
		std::cout << "InheritanceLink_0 STI:" << get_sti(links[0]) << std::endl;
		std::cout << "Leaf_0 STI:           " << get_sti(leaves[0]) << std::endl;
	}
};
