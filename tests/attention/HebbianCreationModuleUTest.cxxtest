/*
 * tests/attention/AttentionAFPerformanceUTest.cxxtest
 *
 * Performance test for Attentional Focus (AF) management
 * without running any agents.
 */

#include <cxxtest/TestSuite.h>

#include <opencog/cogserver/server/CogServer.h>
#include <opencog/attention/AttentionModule.h>
#include <opencog/attention/AttentionParamQuery.h>
#include <opencog/attentionbank/bank/AttentionBank.h>
#include <opencog/attentionbank/types/atom_types.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/util/Config.h>

#include <vector>
#include <chrono>
#include <iostream>

using namespace opencog;
using namespace std;

class AttentionAFPerformanceUTest : public CxxTest::TestSuite
{
private:
    CogServer* _cogserver;

public:
    void setUp()
{
    _cogserver = &cogserver();

    AtomSpace& as = _cogserver->getAtomSpace();

    // Set AF params BEFORE module load
    AttentionParamQuery atq(&as);
    // atq.load_default_values();
    // atq.set_param("MAX_AF_SIZE", 100);

    // Now load module
    config().set("MODULES", "opencog/attention/libattention.so");
    _cogserver->loadModules();
}


    void tearDown()
    {
        _cogserver->stop();
    }

    void testAFManagementAndStimulatePerformance()
    {
        // Use CogServer AtomSpace (IMPORTANT)
        AtomSpace& as = _cogserver->getAtomSpace();
        AttentionBank& ab = attentionbank(&as);

        const size_t TOTAL_ATOMS = 10000;
        const int STIMULUS = 1;

        vector<Handle> nodes;
        nodes.reserve(TOTAL_ATOMS);

        // -------------------------------
        // Create atoms
        // -------------------------------
        for (size_t i = 0; i < TOTAL_ATOMS; ++i)
        {
            Handle h = as.add_node(CONCEPT_NODE, "Node_" + std::to_string(i));
            nodes.push_back(h);
        }
        cout << "\n=== AtomSpace Diagnostics ===\n";
        cout << "Total atoms in AtomSpace: "
               << as.get_size() << endl;

        auto start = chrono::high_resolution_clock::now();

        for (size_t i = 0; i < TOTAL_ATOMS; ++i)
        {
            ab.stimulate(nodes[i], STIMULUS);
        }

        auto end = chrono::high_resolution_clock::now();
        chrono::duration<double> total_time = end - start;

        HandleSeq af2;
        ab.get_handle_set_in_attentional_focus(back_inserter(af2));

        cout << "AF size after stimulations: " << af2.size() << endl;


        cout << "\n=== AF vs AtomSpace ===\n";
        cout << "AtomSpace size: " << as.get_size() << endl;
        cout << "AF size: " << af2.size() << endl;

        cout << "\n=== Sample Atom Attention Values (STI) ===\n";

        for (size_t i : {0, 50, 200, 9655, 9999})
        {
            Handle h = nodes[i];
            double sti = get_av(h)->getSTI();

            cout << h->get_name()
                << " | STI = " << sti
                << endl;
        }
        // size_t count_in_af = 0;

        // for (const auto& h : nodes)
        // {
        //     if (ab.atom_is_in_AF(h))
        //         count_in_af++;
        // }

        // cout << "Atoms in AF (manual count): "
        //     << count_in_af << endl;



        // -------------------------------
        // Performance report
        // -------------------------------
        cout << "\n=== AF Stimulation Performance ===\n";

        cout << "total time : "  << total_time.count() << endl;

        TS_ASSERT(true); // performance-only test
    }
};
